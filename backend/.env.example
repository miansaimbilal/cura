# Server Configuration
PORT=3001
NODE_ENV=development

# Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cura_dev

# JWT Authentication
# Generate secure secrets with: openssl rand -base64 32
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Password Hashing
BCRYPT_ROUNDS=12

# CORS Configuration
# Comma-separated list of allowed origins or single origin
CORS_ORIGIN=http://localhost:8081,exp://localhost:8081

# AI Provider System Configuration (Phase 5)
# Supported providers: gemini | groq | openrouter | cloudflare | xai
AI_DEFAULT_PROVIDER=gemini
AI_REQUEST_TIMEOUT_MS=30000
AI_FAILOVER_ORDER=gemini,groq,openrouter,cloudflare,xai

# Workload-Specific Routing Configuration
# Models are NOT permanently hardcoded; product owner selects the exact model ID for each workload.
#
# Interactive Chat Workload (Allowed providers: groq | openrouter)
# Note: Interactive chat strictly executes on the chosen provider without silent failover.
# Set your preferred conversational model below (Example for Groq: llama-3.1-8b-instant, or query GET /api/ai/models?provider=groq)
AI_CHAT_PROVIDER=groq
# AI_CHAT_MODEL=llama-3.1-8b-instant # (Example only - configure based on live GET /api/ai/models)

# Analytics & Background Insights Workload (Allowed providers: gemini | openrouter | cloudflare)
# Background operations support intelligent multi-key rotation and multi-provider failover.
# Set your preferred analytics model below (Example for Gemini: gemini-2.5-flash or gemini-3.8-flash)
AI_ANALYTICS_PROVIDER=gemini
# AI_ANALYTICS_MODEL=gemini-2.5-flash # (Example only - configure based on live GET /api/ai/models)
AI_ANALYTICS_FALLBACK_PROVIDERS=openrouter,cloudflare

# Multi-Key & Provider Credentials
# Each provider supports single key (legacy fallback) or multi-key configuration via JSON array or CSV list:
# Example CSV: GEMINI_API_KEYS=key1,key2,key3
# Example JSON: GEMINI_API_KEYS=[{"id":"acc1","apiKey":"key1","enabled":true},{"id":"acc2","apiKey":"key2","enabled":true}]

# 1. Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEYS=key1,key2,key3
# GEMINI_DEFAULT_MODEL=gemini-2.5-flash # (Example only)

# 2. Groq
GROQ_API_KEY=your_groq_api_key_here
# GROQ_API_KEYS=key1,key2,key3
# GROQ_DEFAULT_MODEL=llama-3.1-8b-instant # (Example only - discover active models via GET /api/ai/models?provider=groq)

# 3. OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_API_KEYS=key1,key2,key3
# OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.1-8b-instruct # (Example only)

# 4. Cloudflare Workers AI
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
# CLOUDFLARE_CREDENTIALS=[{"id":"cf_main","apiToken":"tok1","accountId":"acc1"},{"id":"cf_backup","apiToken":"tok2","accountId":"acc2"}]
# CLOUDFLARE_DEFAULT_MODEL=@cf/meta/llama-3.1-8b-instruct # (Example only)

# 5. xAI Grok
XAI_API_KEY=your_xai_api_key_here
# XAI_API_KEYS=key1,key2
# XAI_DEFAULT_MODEL=grok-3-latest # (Example only)
